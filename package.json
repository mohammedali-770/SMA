{
  "name": "spicy-meal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "npm --prefix apps/mobile ci --no-audit --no-fund && vite build && npm --prefix apps/mobile run build:web",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "design-system:sync": "node scripts/sync-design-system.mjs",
    "design-system:check": "node scripts/sync-design-system.mjs --check && node scripts/check-design-system-hygiene.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:site": "vite build"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@mapbox/mapbox-gl-draw": "^1.5.1",
    "@sentry/react": "^10.67.0",
    "@supabase/supabase-js": "^2.110.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "mapbox-gl": "^3.25.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^5.4.0",
    "@testing-library/react": "^16.3.2",
    "@types/google.maps": "^3.65.2",
    "@types/mapbox__mapbox-gl-draw": "^1.4.9",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  },
  "//overrides": "Transitive-only security patch. undici reaches this tree once, as a dependency of jsdom, which is a devDependency used only for the vitest jsdom environment — it is never bundled or shipped. The bump stays within the same major (7.28.0 -> 7.29.0), so no dependent's API expectations change. Pinned surgically rather than via `npm audit fix`, per docs/DEPENDENCY_ADVISORIES.md §2.",
  "overrides": {
    "undici": "^7.29.0"
  }
}
