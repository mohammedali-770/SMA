{
  "name": "spicy-meal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "npm --prefix apps/mobile ci --no-audit --no-fund && vite build && npm --prefix apps/mobile run build:web",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "logo:build": "node scripts/build-logo-mark.mjs",
    "logo:check": "node scripts/build-logo-mark.mjs --check",
    "design-system:sync": "node scripts/sync-design-system.mjs",
    "design-system:check": "node scripts/sync-design-system.mjs --check && node scripts/check-design-system-hygiene.mjs",
    "docs:generate": "node scripts/docs-generate.mjs",
    "docs:check": "node scripts/docs-generate.mjs --check && node scripts/docs-check-ownership.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:site": "vite build"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@mapbox/mapbox-gl-draw": "^1.5.1",
    "@sentry/react": "^10.67.0",
    "@supabase/supabase-js": "^2.110.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "mapbox-gl": "^3.25.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^5.4.0",
    "@testing-library/react": "^16.3.2",
    "@types/google.maps": "^3.65.2",
    "@types/mapbox__mapbox-gl-draw": "^1.4.9",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  },
  "//overrides": "Targeted transitive security patches only. undici is a jsdom/vitest dev dependency; nanoid 3.x is pulled by PostCSS/Vite. Both pins stay within the dependency ranges/majors already requested by their parents and avoid broad `npm audit fix` churn. See docs/DEPENDENCY_ADVISORIES.md.",
  "overrides": {
    "nanoid": "3.3.18",
    "undici": "^7.29.0"
  }
}
