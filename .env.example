# Spicy Meal — Vite/admin public client environment.
# Copy to .env.local for local development.
# Vite exposes ONLY VITE_-prefixed values to the browser bundle.
# NEVER put the Supabase service_role key or any provider/server secret here.

VITE_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR-anon-public-key"

# --- Maps (current web/admin provider: Google) ---
# The browser key is public by design but must be restricted in Google Cloud.
# The current map/search path needs Maps JavaScript API + Places API (New).
# Keep the real key in .env.local / Vercel environment variables, never Git.
VITE_MAP_PROVIDER="google"
VITE_GOOGLE_MAPS_API_KEY="YOUR-browser-restricted-google-maps-key"

# --- Mapbox fallback (optional) ---
# Mapbox remains supported by the provider abstraction. To use it, set the
# provider to mapbox and supply a PUBLIC pk.* token restricted appropriately.
# VITE_MAP_PROVIDER="mapbox"
# VITE_MAPBOX_PUBLIC_TOKEN="pk.YOUR-mapbox-public-token"
# VITE_MAPBOX_STYLE_URL="mapbox://styles/mapbox/streets-v12"

# --- Sentry browser configuration (optional overrides) ---
# A Sentry DSN is a public ingestion identifier. The SENTRY_AUTH_TOKEN is NOT:
# never prefix the auth token with VITE_ and never expose it to the browser.
# VITE_SENTRY_DSN="https://PUBLIC_DSN"
# VITE_SENTRY_ENV="development"
# VITE_SENTRY_DEV="1"

# --- Server/provider secrets are NOT frontend variables ---
# Lazywait, WhatsApp/Meta, SMTP, payment/refund and service-role credentials
# belong only in approved server-side integration/secret storage.
#
# Payment/refund code is currently frozen while the final provider is selected;
# do not create local VITE payment-secret variables from old documentation.
# Push source is retained but dormant by product decision.