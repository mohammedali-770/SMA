# Spicy Meal — front-end environment (Vite exposes only VITE_-prefixed vars).
# Copy to .env.local and fill from your Supabase project (Settings → API).
# NEVER put the service_role key here — it must stay server-side only.

VITE_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR-anon-public-key"

# --- Integration secrets (payment / SMS / push / Lazywait) — NOT frontend vars ---
# Provider secrets are stored in the integration_settings table (secret_config,
# admin-only, never returned to the browser) and are read only by server-side
# code (e.g. Supabase Edge Functions) from the service context. Never place a
# real provider secret here or in any VITE_-prefixed variable. Placeholders for
# a future server-only runtime (do NOT prefix with VITE_):
# PAYMENT_SECRET_KEY="set-in-supabase-edge-function-secrets"
# SMS_API_KEY="set-in-supabase-edge-function-secrets"
# PUSH_API_KEY="set-in-supabase-edge-function-secrets"
# LAZYWAIT_API_KEY="set-in-supabase-edge-function-secrets"
