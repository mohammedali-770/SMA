# Spicy Meal — Expo mobile app environment.
#
# Expo exposes ONLY variables prefixed with EXPO_PUBLIC_ to the app bundle.
# The anon (public) key is safe to ship: Row-Level Security is the real
# security boundary. NEVER put the Supabase service_role key, a payment secret,
# an SMS key, or a Lazywait token here — those live server-side only
# (integration_settings table / Edge Function secrets), never in the app.
#
# Copy this file to .env.local and fill from your Supabase project
# (Settings -> API). These are the SAME project values the web/admin app uses.

EXPO_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="YOUR-anon-public-key"

# --- Maps (delivery location picker) ---
# Leave the provider's key blank to run without a map: the picker shows a setup
# message and manual coordinate entry still works. Never commit a real key —
# set it in .env.local locally, and as an EAS environment variable for builds
# (`eas env:create`, see docs/MAPS.md). Keys are NOT stored in eas.json.
#
# Google (current provider). The browser key is public by design but MUST be
# HTTP-referrer restricted in Google Cloud. The WebView is loaded with
# MAP_WEBVIEW_BASE_URL as its base URL so requests carry an allowed referrer —
# inline WebView HTML otherwise sends none and a restricted key is rejected
# with RefererNotAllowedMapError (a blank grey map). Setting the provider to
# google WITHOUT this base URL will not work.
EXPO_PUBLIC_MAP_PROVIDER="google"
EXPO_PUBLIC_GOOGLE_MAPS_BROWSER_KEY="AIza-YOUR-browser-key"
EXPO_PUBLIC_MAP_WEBVIEW_BASE_URL="https://sma.vercel.app/app/"

# Mapbox (alternative provider — set MAP_PROVIDER=mapbox to use). The PUBLIC
# token (pk.…) is shippable but MUST be restricted to this app's bundle id
# (com.spicymeal.app / sa.com.spicymeal.app) in the Mapbox dashboard. Do not
# use a URL-restricted token: a WebView has no URL origin to match.
# EXPO_PUBLIC_MAPBOX_PUBLIC_TOKEN="pk.YOUR-mapbox-public-token"
# EXPO_PUBLIC_MAPBOX_STYLE_URL="mapbox://styles/mapbox/streets-v12"
